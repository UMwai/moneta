# Copy to .env and fill in. Generate the two Moneta secrets below with:
# openssl rand -hex 32

# Seals provider credentials at rest (AES-256-GCM). 64 hex chars = 32 bytes.
# Losing it means re-entering every bank credential.
APP_ENCRYPTION_KEY=

# Signs the session cookie. At least 32 bytes; changing it logs everyone out.
SESSION_SECRET=

# SQLite file. The container image defaults this to /app/data/moneta.db.
DATABASE_PATH=./data/moneta.db

# Optional Plaid fallback. Settings-saved credentials take precedence and are
# sealed in SQLite; use these when configuring the server entirely from env.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Set to 0 or false when serving over plain http on a LAN, so the session cookie
# is not marked Secure and browsers actually keep it.
COOKIE_SECURE=true

# Set to 1 ONLY when Moneta is reachable exclusively through a reverse proxy you
# control that overwrites X-Forwarded-For. It makes the login rate limiter key on
# the first hop of that header. Leave unset when the port is published directly
# (the docker-compose default): the header is attacker-controlled there, and the
# limiter falls back to one shared budget rather than one an attacker can reset
# by rotating the header.
# TRUST_PROXY=1
